{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "../src/game/*.ts", "../src/moderation/*.ts", "../src/config/app.ts"],
  "exclude": ["../src/game/useBoardGame.ts"]
}
