# Copy to .env.local for local development (never commit .env.local).
# For store builds, the same names are set as EAS environment variables (see DEPLOY.md).
# Every value is optional: a missing one turns its feature off, it never crashes the app.

# Leaderboard API. Leave empty in development: the simulator uses http://localhost:8787.
EXPO_PUBLIC_API_URL=

# AdMob ad units (development builds always use Google's test ads instead).
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=

# AdMob app ids — read at build time by app.config.ts (required for production builds).
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=

# RevenueCat public SDK keys ("appl_…" / "goog_…", or a "test_…" Test Store key).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
